;; jolt-metrics config, read by `jolt metrics` (a report, which never fails)
;; and by `jolt metrics:gate` (which does).
;; No :test-paths: dev (the fake servers, demo shots, the self-test harness)
;; is queued like src and test, and jolt metrics:gate holds src/, test/, dev/
;; and ci/ critical-free (ci/metrics-allow.edn). A path named in :test-paths
;; is measured but never queued, so the gate would check nothing there.
;; Left out: build output (target, the app build's jonquil.build),
;; clj-kondo's cache, the deliberately broken smoke fixtures and the
;; docs' demo files. Upstream-lifted code (see UPSTREAM.md) is left out
;; too: it follows DrClojure's source, so it is not ours to refactor.
{:exclude ["target/**" "jonquil.build/**" ".clj-kondo/**" ".superpowers/**"
           ".cpcache/**" "dev/smoke/fixtures/**" "docs/**"
           "src/jonquil/syntax.clj" "src/jonquil/parinfer.clj"
           "src/jonquil/inspect/view.clj"
           "test/jonquil/upstream/**"]
 :test-paths []}
