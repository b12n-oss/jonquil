;; jolt.ffi's macros (defcfn and the with-* forms) are covered by the config
;; jolt exports at clj-kondo.exports/jolt-lang/jolt/ (jolt-lang/jolt#1146),
;; copied into .clj-kondo/imports/jolt-lang/jolt/, which clj-kondo loads on
;; its own. Refresh it from a jolt checkout:
;;
;;   clj-kondo --lint ~/dev/jolt --dependencies --copy-configs
;;
;; (that also copies babashka/sci's export; delete .clj-kondo/imports/babashka,
;; this project doesn't use it). What's left below is Jonquil's own.
{
 ;; dev/smoke/fixtures/*.clj are deliberately invalid or minimal Clojure:
 ;; binary_smoke.clj feeds them to the built jonquil binary to exercise
 ;; unclosed-paren recovery, find, completion, etc. Linting them as project
 ;; code is a category error: measured, they contribute 10 parse and
 ;; unresolved-symbol errors that have nothing to do with Jonquil's code and
 ;; would keep `lint:strict` and the pre-commit hook permanently red.
 :output {:exclude-files ["dev/smoke/fixtures/"]}

 ;; clojure.core.async is built into Jolt (dev/gtk_async.clj and the harness
 ;; rows use it). The project's .clj-kondo/.cache holds an analysis of a
 ;; different core.async, so with the cache (how `bb lint` and the pre-commit
 ;; hook run) the vars Jonquil uses read as unresolved; with `--cache false`
 ;; they don't. Measured 2026-09-27 without this entry: 32 warnings with the
 ;; cache, 13 with --cache false. This keeps both at 13.
 :linters {:unresolved-var {:exclude [clojure.core.async]}
           ;; jolt.host is built into Jolt and loaded before any program, so
           ;; Jonquil calls it without a require, as Jolt's own code does
           :unresolved-namespace {:exclude [jolt.host]}}}
