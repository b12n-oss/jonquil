   :task (apply shell "jolt" "dev/smoke/binary_smoke.clj" *command-line-args*)}
  mcp:smoke
  {:doc "Smoke of `jonquil --mcp` over real stdio (a checkout; pass --bin PATH for the built binary)"
   :task (apply shell "jolt" "dev/smoke/mcp_smoke.clj" *command-line-args*)}
  smoke:cljd
  {:doc "Automated smoke of the ClojureDart attach dialect against your running ClojureDart app (dev/smoke/cljd_app.local.edn names it) via cgevent --pid. Builds ./jonquil first unless --no-build is given."
   :task (apply shell "jolt" "dev/smoke/cljd_smoke.clj" *command-line-args*)}
  smoke:cljs
  {:doc "Smokes the ClojureScript attach dialect against your running shadow-cljs app (dev/smoke/cljs_app.local.edn names it; start the watch and the node script first) via cgevent --pid. Builds ./jonquil first unless --no-build is given."
   :task (apply shell "jolt" "dev/smoke/cljs_smoke.clj" *command-line-args*)}
  upstream:diff
  {:doc "List upstream DrClojure commits since the pin that touch src or test"
   :task (let [blank->nil (fn [s] (when-not (clojure.string/blank? s) s))
               url (or (blank->nil (System/getenv "DRCLOJURE_URL"))
                       "https://github.com/kimtg/DrClojure-Neo")
               given (blank->nil (System/getenv "DRCLOJURE_DIR"))
               ;; A relative XDG_CACHE_HOME is invalid per the XDG spec and is
               ;; ignored, as dev/jolt_nightly.clj does.
               xdg (System/getenv "XDG_CACHE_HOME")
               cache (if (and xdg (clojure.string/starts-with? xdg "/"))
                       xdg
                       (str (System/getProperty "user.home") "/.cache"))
               dir (or given (str cache "/jonquil/drclojure-neo"))
               pin (clojure.string/trim (slurp "UPSTREAM_PIN"))
               fail (fn [msg] (println msg) (System/exit 1))
               ;; Upstream is public: no credential helper and no prompt,
               ;; so a wrong DRCLOJURE_URL fails instead of waiting on a
               ;; login dialog (git-credential-manager did, 2026-10-29).
               ;; An empty GIT_ASKPASS stops git from trying core.askPass
               ;; and SSH_ASKPASS, which IDE terminals set.
               net {:extra-env {"GIT_TERMINAL_PROMPT" "0" "GIT_ASKPASS" ""}}
               anon ["-c" "credential.helper="]]
           ;; DRCLOJURE_DIR is any clone; without it, a cache clone made on
           ;; first use. Fetching by URL means no remote needs a set name.
           (when (and given (not (fs/directory? dir)))
             (fail (str "DRCLOJURE_DIR=" dir " isn't a folder")))
           (when-not (fs/exists? dir)
             (println (str "cloning " url " into " dir))
             (apply shell net "git" (concat anon ["clone" "--quiet" url dir])))
           ;; Only the cache folder is ours to suggest deleting.
           (if given
             (when-not (zero? (:exit (shell {:continue true :out :string :err :string}
                                            "git" "-C" dir "rev-parse" "--git-dir")))
               (fail (str "DRCLOJURE_DIR=" dir " isn't a git clone")))
             (when-not (fs/exists? (fs/file dir ".git"))
               (fail (str dir " isn't a git clone; delete it and run again"))))
           (apply shell net "git" (concat anon ["-C" dir "fetch" "--quiet" url "main"]))
           (let [log (:out (shell {:out :string} "git" "-C" dir "log" "--oneline"
                                  (str pin "..FETCH_HEAD") "--" "src" "test"))]
             (if (clojure.string/blank? log)
               (println (str "no upstream commits since " pin))
               (print log))))}

  verify
  {:doc "Pre-commit gate: lint (report) + test + test:nrepl (must pass)"
   :task (do (shell {:continue true} "clj-kondo" "--lint" "src" "test" "dev")
             (shell "jolt" "-M:test")
             (shell "jolt" "-M:test" "--live"))}

  ;; --- quality ----------------------------------------------------------
  lint
  {:doc "clj-kondo over src, test and dev (report only)"
   :task (let [{:keys [exit]} (shell {:continue true} "clj-kondo" "--lint" "src" "test" "dev")]
           (println (if (zero? exit)
                      "OK clj-kondo: no errors or warnings"
                      "-- clj-kondo: see findings above")))}

  ;; Report only: findings never fail these. metrics.cli exits non-zero
  ;; only on bad usage or a missing directory, and that exit passes through.
  metrics
  {:doc "jolt-metrics report over the repo (Markdown; findings never fail it). Extra args go to metrics.cli: an output file (its extension picks the format), --top N, --no-git, --exclude GLOB"
   :task (apply shell "jolt" "-M:metrics" "." *command-line-args*)}

  metrics:edn
  {:doc "jolt-metrics findings as EDN (findings never fail it). Extra args as for metrics"
   :task (apply shell "jolt" "-M:metrics" "." "--format" "edn" *command-line-args*)}

  metrics:json
  {:doc "jolt-metrics' lean JSON report, for tools (findings never fail it). Extra args as for metrics"
   :task (apply shell "jolt" "-M:metrics" "." "--format" "json" *command-line-args*)}

  metrics:html
  {:doc "jolt-metrics as one self-contained HTML page, target/metrics.html unless a file comes first (findings never fail it). Extra args as for metrics"
   :task (let [args *command-line-args*
               out? (and (seq args) (not (str/starts-with? (first args) "-")))
               args (if out? args (cons "target/metrics.html" args))]
           (some-> (fs/parent (first args)) fs/create-dirs)
           (apply shell "jolt" "-M:metrics" "." "--format" "html" args))}

  lint:strict
  {:doc "lint, but exit non-zero if clj-kondo reports any findings (2=warnings, 3=errors)"
   :task (shell "clj-kondo" "--lint" "src" "test" "dev")}

  lsp:format
  {:doc "Reformat Clojure files (clojure-lsp; mutating). Skips dev/smoke/fixtures -- see lsp-filenames"
   :task (shell "clojure-lsp" "format" "--filenames" (lsp-filenames))}

  lsp:format-check
  {:doc "Check formatting (dry run)"
   :task (shell "clojure-lsp" "format" "--dry" "--filenames" (lsp-filenames))}

  lsp:clean-ns
  {:doc "Clean + organize ns forms (clojure-lsp; mutating). Skips dev/smoke/fixtures -- see lsp-filenames"
   :task (shell "clojure-lsp" "clean-ns" "--filenames" (lsp-filenames))}

  lsp:clean-ns-check
  {:doc "Check ns forms (dry run)"
   :task (shell "clojure-lsp" "clean-ns" "--dry" "--filenames" (lsp-filenames))}

  lsp:check
  {:doc "format + clean-ns, both dry run"
   :task (do (shell "clojure-lsp" "format" "--dry" "--filenames" (lsp-filenames))
             (shell "clojure-lsp" "clean-ns" "--dry" "--filenames" (lsp-filenames)))}

  ;; --- git hooks ----------------------------------------------------------
  hooks:install
  {:doc "Install FAST git pre-commit hook (clj-kondo errors + clojure-lsp format --dry, ~2s)"
   :task (let [hook (str/trim (:out (shell {:out :string} "git" "rev-parse" "--git-path" "hooks/pre-commit")))]
           (hook-preflight!)
           (spit hook (str "#!/bin/bash\n"
                           "# Jonquil pre-commit (FAST -- clj-kondo errors-only + clojure-lsp format --dry).\n"
                           "# Full (+ test suite): jolt hooks:install:full\n"
                           "# The format step runs `jolt lsp:format-check`, so its file list (lsp-filenames\n"
                           "# in bb.edn) is computed fresh on every commit.\n"
                           "echo 'pre-commit 1/2: clj-kondo (errors only)'\n"
                           "clj-kondo --lint src test dev\n"
                           "LINT_EXIT=$?\n"
                           "if [ \"$LINT_EXIT\" = \"3\" ]; then echo 'pre-commit: lint errors found'; exit 1; fi\n"
                           "echo 'pre-commit 2/2: clojure-lsp format --dry'\n"
                           "jolt lsp:format-check >/dev/null || { echo 'run jolt lsp:format'; exit 1; }\n"
                           "exit 0\n"))
           (shell "chmod" "+x" hook)
           (println "OK fast pre-commit hook installed")
           (println ">> skip once with: git commit --no-verify"))}

  hooks:install:full
  {:doc "Install FULL git pre-commit hook (clj-kondo errors + format --dry + unit tests, slower)"
   :task (let [hook (str/trim (:out (shell {:out :string} "git" "rev-parse" "--git-path" "hooks/pre-commit")))]
           (hook-preflight!)
           (spit hook (str "#!/bin/bash\n"
                           "# Jonquil pre-commit (FULL). Fast: jolt hooks:install\n"
                           "echo 'pre-commit 1/3: clj-kondo (errors only)'\n"
                           "clj-kondo --lint src test dev\n"
                           "LINT_EXIT=$?\n"
                           "if [ \"$LINT_EXIT\" = \"3\" ]; then echo 'pre-commit: lint errors found'; exit 1; fi\n"
                           "echo 'pre-commit 2/3: clojure-lsp format --dry'\n"
                           "jolt lsp:format-check >/dev/null || { echo 'run jolt lsp:format'; exit 1; }\n"
                           "echo 'pre-commit 3/3: unit tests'\n"
                           "jolt -M:test\n"
                           "exit $?\n"))
           (shell "chmod" "+x" hook)
           (println "OK full pre-commit hook installed")
           (println ">> skip once with: git commit --no-verify"))}

  hooks:uninstall
  {:doc "Remove the git pre-commit hook"
   :task (let [hook (str/trim (:out (shell {:out :string} "git" "rev-parse" "--git-path" "hooks/pre-commit")))]
           (if (fs/exists? hook)
             (do (fs/delete hook) (println "OK pre-commit hook removed"))
             (println ">> no pre-commit hook found")))}

  ;; --- docs -----------------------------------------------------------------
  site:build
  {:doc "Build the documentation site into _site/ (needs a docs-engine checkout)"
   :task (site-task "build")}

  site:serve
  {:doc "Build the docs site and serve it locally; first free port from 3000, or site:serve PORT (refused if busy)"
   :task (let [asked (first *command-line-args*)
               port  (or asked (free-port 3000))]
           (if port
             (site-task "serve" (str port))
             (do (println "No free port in 3000-3020 on 127.0.0.1; pass one: jolt site:serve PORT")
                 (System/exit 1))))}

