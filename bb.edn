;; Task runner for Jonquil -- a DrRacket-style Clojure IDE written in Jolt.
;;
;; Run these with `jolt <task>`: jolt reads this file as well as deps.edn,
;; so the name bb.edn stays though babashka isn't needed. `jolt info` prints
;; the grouped cheat-sheet; `jolt tasks` lists everything alphabetically.
;;
;; NOTE: task bodies are EDN-parsed. No #"regex", no @deref, no #(...) --
;; use (re-pattern "...") , (deref ...) and (fn [x] ...) instead.
{:tasks
 {:requires ([babashka.fs :as fs]
             [clojure.string :as str])

  :init
  (do
    (defn lsp-filenames
      "The --filenames scope for clojure-lsp's format and clean-ns commands:
       src, test, and every real dev/*.clj entry, joined with a comma (NOT
       `::` -- measured against clojure-lsp 2026.05.05-12.58.26, a `::`-joined
       multi-entry list throws a FileNotFoundException on the bare project
       root instead of doing anything with the entries).

       dev/smoke/fixtures/*.clj are deliberately invalid or minimal Clojure,
       fed to the built jonquil binary by dev/smoke/binary_smoke.clj to
       exercise unclosed-paren recovery, completion, find, etc. clojure-lsp's
       format and clean-ns commands parse every file under a discovered
       source-path with rewrite-clj, which throws a hard \"Unexpected EOF\"
       on fixtures/unclosed.clj and aborts the whole run -- measured with no
       scoping at all, and again with :source-paths-ignore-regex targeting
       the fixtures path (neither stops the crash, because \"dev\" is itself
       the discovered source-path and the ignore-regex only filters
       candidate source-path roots, not files underneath one already
       chosen). So this function is the one place that keeps fixtures out of
       clojure-lsp's reach, by listing dev's real entries explicitly instead
       of handing clojure-lsp the whole directory.

       Rebuilt on every call rather than cached in a def, so a new top-level
       dev/*.clj file is picked up the next time any lsp: task runs; only
       dev/smoke/fixtures and dev/smoke/PixelAt.java need to stay off it,
       and both are excluded by the .clj filter below, not by name."
      []
      (let [clj? (fn [p] (str/ends-with? (str p) ".clj"))
            ;; A dev/ folder is listed by its .clj files, never whole:
            ;; clojure-lsp parses every file in a folder it's handed, and
            ;; dev/linux's Dockerfile threw "A single colon is not a valid
            ;; keyword" at the colon of its first line (2026-10-20).
            dev-top (->> (fs/list-dir "dev")
                         (remove (fn [p] (= "smoke" (str (fs/file-name p)))))
                         (mapcat (fn [p] (if (fs/directory? p) (sort (fs/glob p "**.clj")) [p])))
                         (filter clj?))
            smoke   (->> (fs/list-dir "dev/smoke")
                         (filter (fn [p] (str/ends-with? (str p) ".clj"))))
            ;; Upstream lifts stay byte-close to kimtg/DrClojure-Neo so a
            ;; future re-sync diffs cleanly; the formatter would double their
            ;; divergence (syntax.clj: 170 -> 324 differing lines, measured).
            lifted  #{"src/jonquil/syntax.clj" "test/jonquil/upstream/syntax_test.clj"}
            src+test (->> (concat (fs/glob "src" "**.clj") (fs/glob "test" "**.clj"))
                          (map str)
                          (remove lifted)
                          sort)]
        (->> (concat src+test dev-top smoke)
             (map str)
             (str/join ","))))

    (defn hook-preflight!
      "Run the checks the hook will run, and say which of them fail RIGHT
       NOW. Installing a pre-commit hook against a tree that already fails
       its own checks blocks every commit, and the failure arrives later,
       at the worst moment, looking like the hook itself is broken. So warn,
       then install anyway -- the operator asked for the hook, and
       --no-verify is one flag away."
      []
      (let [kondo  (:exit (shell {:continue true :out :string :err :string}
                                 "clj-kondo" "--lint" "src" "test" "dev"))
            fmt    (:exit (shell {:continue true :out :string :err :string}
                                 "clojure-lsp" "format" "--dry" "--filenames" (lsp-filenames)))
            broken (remove nil?
                           [(when (= 3 kondo) "clj-kondo reports errors (exit 3)")
                            (when-not (zero? fmt) "clojure-lsp format --dry reports diffs")])]
        (when (seq broken)
          (println "!! This tree does not pass the hook's own checks yet:")
          (doseq [b broken] (println (str "     - " b)))
          (println "   Installing anyway. Until these are clean the hook will")
          (println "   reject every commit; bypass one with: git commit --no-verify")
          (println))))

    ;; --- documentation site -------------------------------------------------
    ;; The generator lives in jlt-commons/docs-engine, not here, so these
    ;; tasks are local preview only and are the one place needing that
    ;; checkout.
    (def docs-engine-repo "https://github.com/jlt-commons/docs-engine")

    (defn docs-engine-dir
      "Where the engine is checked out: $JLT_DOCS_ENGINE, else the usual
       jlt-commons spot, else a sibling directory. nil when none exist. The
       jlt-commons checkout comes before ../docs-engine because a sibling
       there can be an unrelated older fork, which would otherwise shadow
       the real engine silently."
      []
      (let [home (System/getProperty "user.home")]
        (->> [(System/getenv "JLT_DOCS_ENGINE")
              (str home "/dev/jlt-commons/docs-engine")
              "../docs-engine"]
             (remove nil?)
             (filter (fn [d] (fs/exists? (fs/file d "bb.edn"))))
             first)))

    (defn free-port
      "First port from base up to base+20 that is free on every interface
       right now, or nil. The engine does the real bind a moment later, so this is a
       probe: a port taken in between fails loudly in the engine, not
       silently. An explicit port is never scanned (see site:serve)."
      [base]
      (let [binds?     (fn [p addr]
                         (try (with-open [_ (java.net.ServerSocket. p 1 (java.net.InetAddress/getByName addr))] true)
                              (catch Exception _ false)))
            ;; Java binds dual-stack on macOS, so the binds above miss an IPv4
            ;; wildcard listener (measured with a python one); connecting sees it.
            listening? (fn [p]
                         (try (with-open [_ (java.net.Socket. "127.0.0.1" (int p))] true)
                              (catch Exception _ false)))]
        ;; All three probes: a 127.0.0.1 bind succeeds on macOS even while another
        ;; process holds *:p (measured: Docker on *:3001), and then localhost
        ;; traffic silently reaches whichever listener the OS prefers.
        (some (fn [p] (when (and (binds? p "0.0.0.0") (binds? p "127.0.0.1") (not (listening? p))) p))
              (range base (+ base 21)))))

    (defn linux-arch
      "The --arch value for the linux: tasks (arm64 or amd64); the host's own
       architecture when absent. Anything else exits with a message."
      [args]
      (let [flag  (drop-while (fn [a] (not (str/starts-with? a "--arch"))) args)
            asked (when-let [a (first flag)]
                    (if (= a "--arch")
                      (or (second flag) "(missing value)")
                      (str/replace-first a "--arch=" "")))
            host  (System/getProperty "os.arch")
            arch  (or asked
                      (case host
                        ("aarch64" "arm64") "arm64"
                        ("x86_64" "amd64") "amd64"
                        host))]
        (if (contains? #{"arm64" "amd64"} arch)
          arch
          (do (println (str "Unsupported architecture: " arch " (use --arch arm64 or --arch amd64)"))
              (System/exit 1)))))

    (defn linux-strip-arch
      "args without the --arch flag: both `--arch A` and `--arch=A`, value included."
      [args]
      (loop [in (seq args) out []]
        (cond
          (empty? in) out
          (= (first in) "--arch") (recur (nnext in) out)
          (str/starts-with? (first in) "--arch=") (recur (next in) out)
          :else (recur (next in) (conj out (first in))))))

    (defn linux-run-split
      "linux:run's args as [arch-args command]: a leading `--arch A` or
       `--arch=A`, then an optional `--`, then the command. The `--` is
       optional because jolt drops the first standalone `--` from a task's
       args (POSIX end-of-options) where bb keeps it."
      [args]
      (loop [in (vec args) opts []]
        (let [a (first in)]
          (cond
            (= a "--arch") (recur (subvec in (min 2 (count in))) (into opts (take 2 in)))
            (and a (str/starts-with? a "--arch=")) (recur (subvec in 1) (conj opts a))
            (= a "--") [opts (subvec in 1)]
            :else [opts in]))))

    (defn sh-quote
      "s as one single-quoted word for a POSIX shell."
      [s]
      (str "'" (str/replace s "'" "'\\''") "'"))

    (defn linux-docker
      "Runs command (a bash string) in the jonquil-linux:<arch> container, on a
       copy of the read-only checkout at ~/jonquil. out, when given, is a host
       dir mounted read-write at /out. docker-args are extra `docker run` flags
       (a name, a published port). Exits with the container's status, or
       returns it when return-status? is true."
      [{:keys [arch command out docker-args return-status?]}]
      (let [copy (str "set -eo pipefail; mkdir -p ~/jonquil; shopt -s dotglob nullglob; "
                      ;; cp, not tar: under amd64 emulation GNU tar's stat of some files
                      ;; on the read-only mount fails with ENOSYS (measured), and cp -a
                      ;; copies the same tree cleanly. The case skips the Mac's builds.
                      "for e in /src/*; do case ${e#/src/} in "
                      "jonquil|jonquil.build|Jonquil.app|_site|target) ;; "
                      "*) cp -a \"$e\" ~/jonquil/ ;; esac; done; cd ~/jonquil; ")
            argv (concat ["docker" "run" "--rm" "--init" "--platform" (str "linux/" arch)
                          "-v" (str (fs/cwd) ":/src:ro")]
                         (when out ["-v" (str out ":/out")])
                         docker-args
                         [(str "jonquil-linux:" arch) "bash" "-lc" (str copy command)])
            res  (apply shell {:continue true} argv)]
        (if return-status? (:exit res) (System/exit (:exit res)))))

    (defn linux-vnc
      "Runs the desktop session container (dev/linux/vnc-session.sh) with the
       noVNC port published on 127.0.0.1:port, and prints the URL once it
       answers. The container is removed on every exit path: a finally, and a
       shutdown hook for the signals that skip it."
      [{:keys [arch port]}]
      (let [cname   (str "jonquil-vnc-" port)
            url     (str "http://localhost:" port "/vnc.html")
            ;; ProcessBuilder, not shell: shell registers a shutdown hook of its own,
            ;; which throws "Shutdown in progress" inside this one (measured).
            rm!     (fn [] (-> (ProcessBuilder. ["docker" "rm" "-f" cname])
                               (.redirectOutput java.lang.ProcessBuilder$Redirect/DISCARD)
                               (.redirectError java.lang.ProcessBuilder$Redirect/DISCARD)
                               (.start)
                               (.waitFor)))
            ;; Twice, a second apart: an interrupt right after start can reach the
            ;; docker client before the daemon has created the container (measured).
            cleanup (fn [] (rm!) (Thread/sleep 1000) (rm!))]
        (.addShutdownHook (Runtime/getRuntime) (Thread. (fn [] (cleanup))))
        (future
          (loop [tries 0]
            (let [code (:out (shell {:continue true :out :string :err :null}
                                    "curl" "-s" "-o" "/dev/null" "-w" "%{http_code}" url))]
              (cond
                (= code "200") (println (str "Open " url "?autoconnect=true&resize=scale (Ctrl-C to stop)"))
                (< tries 600)  (do (Thread/sleep 1000) (recur (inc tries)))
                :else          (println (str "The desktop did not answer on " url " within 10 minutes."))))))
        (println (str "Starting the Linux desktop on port " port " (the first start builds Jonquil, about a minute)..."))
        (let [status (try
                       (linux-docker {:arch arch :return-status? true
                                      :docker-args ["--name" cname "-p" (str "127.0.0.1:" port ":6080")]
                                      :command "dev/linux/vnc-session.sh"})
                       (finally (cleanup)))]
          (System/exit status))))

    (defn site-task
      "Runs one of the engine's tasks against this project."
      [task & args]
      (if-let [engine (docs-engine-dir)]
        ;; jolt has its own build and run commands, so `jolt run <task>` reaches
        ;; the engine's task of that name. serve is the exception: the
        ;; engine's server is http-kit, which jolt doesn't bundle, so its own
        ;; info says serve stays babashka-only (bb serve <project> [port])
        (let [bb?  (= "serve" task)
              argv (into (if bb? ["bb" task (str (fs/cwd))] ["jolt" "run" task (str (fs/cwd))])
                         (remove nil? args))]
          (when (and bb? (not (fs/which "bb")))
            (println "site:serve runs the docs engine's server, which needs babashka (bb) on PATH:")
            (println "  https://github.com/babashka/babashka#installation")
            (System/exit 1))
          (let [res (apply shell {:dir (str engine) :continue true} argv)]
            (when-not (zero? (:exit res)) (System/exit (:exit res)))))
        (do
          (println "The docs engine is not checked out anywhere I looked:")
          (println "  $JLT_DOCS_ENGINE, ~/dev/jlt-commons/docs-engine, ../docs-engine")
          (println)
          (println "  git clone" docs-engine-repo "../docs-engine")
          (println)
          (System/exit 1)))))

  info
  {:doc "Grouped task cheat-sheet (start here; easier to scan than `tasks`)"
   :task
   (let [esc (str (char 27) "[")
         col (fn [c s] (str esc c "m" s esc "0m"))
         hdr (fn [s] (println (str "\n" (col "35" (str "── " s " ──")))))
         row (fn [t d] (println (str "  " (col "36" (format "%-32s" (str "jolt " t))) d)))]
     (println (col "1;35" "\nJonquil: a DrRacket-style Clojure IDE written in Jolt"))
      (hdr "Verify")
     (row "check" "require every project namespace headlessly, exit 0")
     (row "test" "run the unit suite; pass namespace names to run a subset")
     (row "test:nrepl" "live nREPL tests: spawn Jolt children (need the jolt-lang/nrepl checkout)")
     (row "test:debugger [--no-window]" "the debugger's tests on a Jolt with jolt.debug (JONQUIL_JOLT_DEBUG, jolt-debug or jolt; skips without one)")
     (row "test:nightly [--offline]" "test:nrepl against Jolt's nightly build, cached under ~/.cache/jonquil/jolt-nightly (needs curl)")
     (row "test:clj" "live JVM tests: start a real clojure -M:serve (need java 17+ and the clojure CLI)")
     (row "test:jank" "live jank tests: launch a real jank repl (JONQUIL_JANK or any jank on PATH; skips without one)")
     (row "test:cljs-node" "live ClojureScript-on-node tests: launch a real clojure + node prepl (need the clojure CLI and node; skips without them)")
     (row "test:bb" "live nREPL-dialect tests: start a real bb nrepl-server (need bb on PATH; skips without one)")
     (row "test:basilisp" "the same against a real basilisp nrepl-server (JONQUIL_BASILISP or basilisp on PATH; skips without one)")
     (row "test:plugins" "live isolated plugin checks: run real jolt checker children (skips without jolt)")
     (row "verify" "lint (report) + test + test:nrepl (must pass), the pre-commit gate")
     (hdr "Run and build")
     (row "app:run [file|dir]" "launch Jonquil, optionally on a file or a project folder")
     (row "app:build" "build the ./jonquil binary (unsigned on macOS)")
     (row "app:bundle" "rebuild ./jonquil, then make ./Jonquil.app from it (macOS)")
     (row "app:release" "a self-contained target/Jonquil.app and its zip, GTK bundled (macOS, Apple Silicon)")
     (row "app:release-check" "launch target/Jonquil.app with /opt/homebrew blocked; fails on a library from outside it")
     (row "app:install" "install Jonquil: ~/Applications on macOS, ~/.local/share on Linux (macOS and Linux)")
     (row "app:uninstall" "remove what app:install put in place (macOS and Linux)")
     (row "app:icon" "regenerate resources/Jonquil.icns and the 256 px Linux PNG from resources/icon/icon.swift (macOS)")
     (row "bench:edit [sizes...]" "time editing stalls on large files (opens a real window per size)")
     (row "smoke:binary" "automated smoke of the BUILT ./jonquil binary via cgevent")
     (row "mcp:smoke [--bin PATH] [--window|--attach]" "smoke of `jonquil --mcp` over real stdio; --window drives a real window, --attach bridges to a listening one (checkout, or the built binary)")
     (row "smoke:cljd" "automated smoke of the ClojureDart dialect against your running app")
     (row "smoke:cljs" "automated smoke of the ClojureScript dialect against your running shadow-cljs app")
     (hdr "Self-test and docs")
     (row "gtk:selftest" "open real GTK windows and run the front-end self-test rows")
     (row "docs:shots" "self-capture docs/images/*.png (+ one GIF), one process per scene")
     (hdr "Quality: lint and format")
     (row "lint" "clj-kondo over src, test and dev (report only)")
     (row "lint:strict" "lint, but exit non-zero if there are any findings")
     (row "metrics [OUT] [opts]" "jolt-metrics report: refactoring queue, hotspots, cleanup (report only)")
     (row "metrics:edn [OUT] [opts]" "the same metrics, every finding as EDN")
     (row "metrics:json [OUT] [opts]" "the same metrics as lean JSON, for tools")
     (row "metrics:html [OUT] [opts]" "the same metrics as one HTML page (target/metrics.html)")
     (row "lsp:format" "reformat Clojure files (clojure-lsp; mutating)")
     (row "lsp:format-check" "check formatting (dry run)")
     (row "lsp:clean-ns" "clean + organize ns forms (clojure-lsp; mutating)")
     (row "lsp:clean-ns-check" "check ns forms (dry run)")
     (row "lsp:check" "format + clean-ns, both dry run")
     (hdr "Git hooks")
     (row "hooks:install" "install FAST pre-commit hook (lint errors + format --dry)")
     (row "hooks:install:full" "install FULL pre-commit hook (+ unit tests, slower)")
     (row "hooks:uninstall" "remove the git pre-commit hook")
     (hdr "Docs (local preview; the engine lives in jlt-commons/docs-engine)")
     (row "site:build" "build the documentation site into _site/")
     (row "site:serve [port]" "build, then serve it (first free port from 3000; needs bb)")
     (row "site:clean" "delete the _site/ build output")
     (hdr "Linux (local Docker, no CI)")
     (row "linux:image [--arch A]" "build the jonquil-linux:<arm64|amd64> image (host arch by default)")
     (row "linux:test [--arch A] [ns...]" "jolt test inside the image, on a copy of the checkout")
     (row "linux:selftest [--arch A]" "jolt gtk:selftest inside the image, under Xvfb")
     (row "linux:build [--arch A]" "jolt app:build inside the image; binary lands in target/linux/<A>/")
     (row "linux:run [--arch A] [--] cmd" "run any command in the copied tree inside the image")
     (row "linux:vnc [--arch A] [--port P]" "a Linux desktop with Jonquil installed, in your browser via noVNC")
     (row "linux:clean" "remove both jonquil-linux images and target/linux")
     (row "clean:tmp [--dry-run]" "delete temp dirs earlier test runs left in java.io.tmpdir")
     (hdr "Upstream")
     (row "upstream:diff" "list upstream DrClojure commits since the pin, touching src/test")
     (println (str "\n" (col "2" "first run: jolt check, then jolt test, then jolt app:run"))))}

  test  {:doc "Run tests; pass namespace names to run a subset"
         :task (apply shell "jolt" "-M:test" *command-line-args*)}
  test:nrepl {:doc "Live nREPL tests: spawn Jolt children (need the jolt-lang/nrepl checkout)"
              :task (shell "jolt" "-M:test" "--live")}
  test:debugger {:doc "The debugger's tests on a Jolt with jolt.debug (JONQUIL_JOLT_DEBUG, jolt-debug or jolt; skips without one); --no-window leaves out the window self-test"
                 :task (apply shell "jolt" "dev/debugger_check.clj" *command-line-args*)}
  test:nightly {:doc "test:nrepl against Jolt's nightly build (downloaded and checked into ~/.cache/jonquil/jolt-nightly; --offline reuses it)"
                :task (apply shell "jolt" "dev/jolt_nightly.clj" *command-line-args*)}
  test:clj {:doc "Live JVM tests: start a real clojure -M:serve (need java 17+ and the clojure CLI)"
            :task (shell "jolt" "-M:test" "--live-clj")}
  test:bb {:doc "Live nREPL-dialect tests: start a real bb nrepl-server (need bb on PATH; skips without one)"
           :task (shell "jolt" "-M:test" "--live-bb")}
  test:basilisp {:doc "Live nREPL-dialect tests: start a real basilisp nrepl-server (JONQUIL_BASILISP or basilisp on PATH; skips without one)"
                 :task (shell "jolt" "-M:test" "--live-basilisp")}
  test:cljs-node {:doc "Live ClojureScript-on-node tests: launch a real clojure + node prepl (need the clojure CLI and node; skips without them)"
                  :task (shell "jolt" "-M:test" "--live-cljs-node")}
  test:plugins {:doc "Live isolated plugin checks: run real jolt checker children (skips without jolt on the login PATH)"
                :task (shell "jolt" "-M:test" "--live-plugins")}
  test:jank {:doc "Live jank tests: launch a real jank repl (JONQUIL_JANK or any jank on PATH; skips without one)"
             :task (shell "jolt" "-M:test" "--live-jank")}
  bench:edit {:doc "Benchmark editing stalls on large files; opens a real window per size (default sizes 200 2000 8000 20000)"
              :task (apply shell "jolt" "-M:bench" *command-line-args*)}
  check {:doc "Headless compile-check of every project namespace"
         :task (shell "jolt" "-M:check")}
  gtk:selftest
  {:doc "Open ten real GTK windows in turn and run the front-end self-test rows (the third runs Jolt over nREPL, the fourth attaches to a fake ClojureDart app, the fifth attaches to a fake JVM nREPL server, the sixth is launched on a directory, the seventh runs a jank window against a fake jank process, the eighth is launched with file and folder arguments, the ninth attaches to a fake shadow-cljs server, the tenth runs a ClojureScript-on-node window against a fake clojure launcher)"
   :task (let [r1 (shell {:continue true} "jolt" "-M:selftest")
               r2 (shell {:continue true} "jolt" "-M:selftest-window")
               r3 (shell {:continue true} "jolt" "-M:selftest-nrepl")
               r4 (shell {:continue true} "jolt" "-M:selftest-cljd")
               r5 (shell {:continue true} "jolt" "-M:selftest-clj")
               r6 (shell {:continue true} "jolt" "-M:selftest-tree")
               r7 (shell {:continue true :extra-env {"JONQUIL_JANK" (str (fs/absolutize "dev/fake-jank"))}}
                         "jolt" "-M:selftest-jank")
               r8 (shell {:continue true} "jolt" "-M:selftest-args")
               r9 (shell {:continue true} "jolt" "-M:selftest-cljs")
               r10 (shell {:continue true :extra-env {"JONQUIL_CLOJURE" (str (fs/absolutize "dev/fake-cljs-clojure"))
                                                      "FAKE_CLJS_SLOW_MS" "30000"
                                                      "JONQUIL_OPEN_URL" (str (fs/absolutize "dev/fake-open-url"))
                                                      "FAKE_OPEN_URL_LOG" (str (fs/path (System/getProperty "java.io.tmpdir") (str "jonquil-selftest-open-url-" (System/currentTimeMillis) ".log")))}}
                          "jolt" "-M:selftest-cljs-node")
               ok1 (zero? (:exit r1))
               ok2 (zero? (:exit r2))
               ok3 (zero? (:exit r3))
               ok4 (zero? (:exit r4))
               ok5 (zero? (:exit r5))
               ok6 (zero? (:exit r6))
               ok7 (zero? (:exit r7))
               ok8 (zero? (:exit r8))
               ok9 (zero? (:exit r9))
               ok10 (zero? (:exit r10))]
           (when-not ok1 (println "gtk:selftest: editor/console rows FAILED"))
           (when-not ok2 (println "gtk:selftest: window rows FAILED"))
           (when-not ok3 (println "gtk:selftest: nREPL rows FAILED"))
           (when-not ok4 (println "gtk:selftest: ClojureDart rows FAILED"))
           (when-not ok5 (println "gtk:selftest: JVM Clojure rows FAILED"))
           (when-not ok6 (println "gtk:selftest: directory-launch rows FAILED"))
           (when-not ok7 (println "gtk:selftest: jank rows FAILED"))
           (when-not ok8 (println "gtk:selftest: file-argument rows FAILED"))
           (when-not ok9 (println "gtk:selftest: ClojureScript rows FAILED"))
           (when-not ok10 (println "gtk:selftest: ClojureScript-on-node rows FAILED"))
           (System/exit (if (and ok1 ok2 ok3 ok4 ok5 ok6 ok7 ok8 ok9 ok10) 0 1)))}
  docs:shots
  {:doc "Self-capture docs/images/*.png (+ one GIF): one fresh process per scene"
   ;; One shared process/window for every scene let every scene inherit every earlier scene's console history, so a scene's
   ;; screenshot showed more than its own output. A fresh `jolt -M:shots
   ;; <scene-id>` process per scene means a fresh session and an empty
   ;; console every time. This scene-id list is kept in sync by hand with
   ;; dev/demo_shots.clj's own `scenes` list, the same way dev/check.clj
   ;; and dev/test_runner.clj's namespace lists are.
   :task (let [scene-ids ["window" "repl" "stdin" "stop" "unbalanced" "unicode" "run-while-running"
                          "find" "run-selection" "close-prompt"
                          "theme-light" "theme-dark" "theme-solarized" "theme-navy"
                          "completion" "quick-doc" "rename" "inspector"
                          "clj-attach" "clj-quick-doc" "clj-full-doc" "clj-inspector" "clj-source" "tabs" "file-tree"
                          "parinfer" "parinfer-project"
                          "find-usages" "compare-form" "reader" "change-sets" "breakpoint" "trace" "line-counts" "processes" "messages"
                          "jank" "cljs-node" "cljs-browser" "nrepl-bb" "cljs-shadow"]
               results (mapv (fn [id]
                               (let [;; The console prints the clojure path; a bare name
                                     ;; keeps a home directory out of the image.
                                     env (when (#{"cljs-node" "cljs-browser" "cljs-shadow"} id)
                                           {"JONQUIL_CLOJURE" (or (System/getenv "JONQUIL_CLOJURE") "clojure")})
                                     r (shell {:continue true :extra-env env} "jolt" "-M:shots" id)]
                                 {:id id :ok (zero? (:exit r))}))
                             scene-ids)
               failed (filterv (fn [r] (not (:ok r))) results)]
           (doseq [r results]
             (println (str "docs:shots: " (:id r) " " (if (:ok r) "PASS" "FAIL"))))
           (when (seq failed)
             (println (str "docs:shots: " (count failed) " of " (count results) " scenes FAILED")))
           (System/exit (if (seq failed) 1 0)))}
  app:run
