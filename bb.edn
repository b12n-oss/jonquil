   :task (shell "jolt" "-M:bundle" "-m" "app-bundle" "uninstall")}
  app:icon
  {:doc "Regenerate resources/Jonquil.icns: swift draws a 1024px PNG, sips scales it, iconutil packs it; then sips makes resources/icon/jonquil-256.png for the Linux install (macOS)"
   :task (let [tmp (str (fs/create-temp-dir {:prefix "jonquil-icon-"}))
               set-dir (str tmp "/Jonquil.iconset")
               big (str tmp "/icon-1024.png")]
           (try
             (fs/create-dirs set-dir)
             (shell "swift" "resources/icon/icon.swift" big)
             (doseq [n [16 32 128 256 512]]
               (shell "sips" "-z" (str n) (str n) big "--out" (str set-dir "/icon_" n "x" n ".png"))
               (shell "sips" "-z" (str (* 2 n)) (str (* 2 n)) big "--out" (str set-dir "/icon_" n "x" n "@2x.png")))
             (shell "iconutil" "-c" "icns" set-dir "-o" "resources/Jonquil.icns")
             (shell "sips" "-s" "format" "png" "-z" "256" "256" "resources/Jonquil.icns" "--out" "resources/icon/jonquil-256.png")
             (finally (fs/delete-tree tmp))))}
