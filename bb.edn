{:tasks
 {test  {:doc "Run tests; pass namespace names to run a subset"
         :task (apply shell "jolt" "-M:test" *command-line-args*)}
  check {:doc "Headless compile-check of every project namespace"
         :task (shell "jolt" "-M:check")}
  gtk:selftest
  {:doc "Open two real GTK windows in turn and run the P2 front-end self-test rows"
   :task (let [r1 (shell {:continue true} "jolt" "-M:selftest")
               r2 (shell {:continue true} "jolt" "-M:selftest-window")
               ok1 (zero? (:exit r1))
               ok2 (zero? (:exit r2))]
           (when-not ok1 (println "gtk:selftest: editor/console rows FAILED"))
           (when-not ok2 (println "gtk:selftest: window rows FAILED"))
           (System/exit (if (and ok1 ok2) 0 1)))}
  docs:shots
  {:doc "Self-capture docs/images/*.png (+ one GIF): one fresh process per scene"
   ;; P2.T9 round 1: one shared process/window for all 7 scenes let every
   ;; scene inherit every earlier scene's console history, so a scene's
   ;; screenshot showed more than its own output. A fresh `jolt -M:shots
   ;; <scene-id>` process per scene means a fresh session and an empty
   ;; console every time. This scene-id list is kept in sync by hand with
   ;; dev/demo_shots.clj's own `scenes` list, the same way dev/check.clj
   ;; and dev/test_runner.clj's namespace lists are.
   :task (let [scene-ids ["window" "repl" "stdin" "stop" "unbalanced" "unicode" "run-while-running"
                          "find" "run-selection" "close-prompt"
                          "theme-light" "theme-dark" "theme-solarized" "theme-navy"
                          "completion" "quick-doc" "rename"]
               results (mapv (fn [id]
                               (let [r (shell {:continue true} "jolt" "-M:shots" id)]
                                 {:id id :ok (zero? (:exit r))}))
                             scene-ids)
               failed (filterv (fn [r] (not (:ok r))) results)]
           (doseq [r results]
             (println (str "docs:shots: " (:id r) " " (if (:ok r) "PASS" "FAIL"))))
           (when (seq failed)
             (println (str "docs:shots: " (count failed) " of " (count results) " scenes FAILED")))
           (System/exit (if (seq failed) 1 0)))}
  app:run
  {:doc "Launch Jonquil, optionally opening a file"
   :task (apply shell "jolt" "-M" "-m" "jonquil.main" *command-line-args*)}
  app:build
  {:doc "Build the ./jonquil binary (unsigned on macOS)"
   :task (shell "jolt" "build" "-m" "jonquil.main" "-o" "jonquil")}
  smoke:binary
  {:doc "P2.T10: automated smoke of the BUILT ./jonquil binary via cgevent --pid. Builds into target/smoke/jonquil first unless --no-build is given."
   :task (apply shell "bb" "dev/smoke/binary_smoke.clj" *command-line-args*)}
  upstream:diff
  {:doc "List upstream DrClojure commits since the pin that touch src or test"
   :task (let [dir (or (System/getenv "DRCLOJURE_DIR")
                       (str (System/getProperty "user.home")
                            "/dev/b12n-oss/kimtg--DrClojure-Neo"))
               pin (clojure.string/trim (slurp "UPSTREAM_PIN"))]
           (shell {:dir dir} "git" "fetch" "--quiet" "upstream")
           (shell {:dir dir} "git" "log" "--oneline"
                  (str pin "..upstream/main") "--" "src" "test"))}}}
