  {:doc "Delete the _site/ build output"
   :task (site-task "clean")}

  linux:image
  {:doc "Build the local Linux check image jonquil-linux:<arch> (--arch arm64|amd64; the host's by default)"
   :task (let [arch (linux-arch *command-line-args*)]
           (shell "docker" "build" "--platform" (str "linux/" arch)
                  "-t" (str "jonquil-linux:" arch) "dev/linux"))}
  linux:test
  {:doc "Run jolt test [ns...] in the Linux image on a copy of the checkout (--arch arm64|amd64)"
   :task (let [arch (linux-arch *command-line-args*)
               nss  (linux-strip-arch *command-line-args*)]
           (linux-docker {:arch arch
                          :command (str/join " " (cons "jolt test" (map sh-quote nss)))}))}
  linux:selftest
  {:doc "Run jolt gtk:selftest under Xvfb in the Linux image (--arch arm64|amd64)"
   :task (let [arch (linux-arch *command-line-args*)
               ;; Another arch than the host's runs under emulation, several
               ;; times slower; rows with a time budget widen it (see
               ;; gtk-selftest's paint-async row).
               emulated? (not= arch (linux-arch []))]
           (linux-docker {:arch arch
                          :command (str (when emulated? "JONQUIL_SELFTEST_EMULATED=1 ")
                                        "GDK_BACKEND=x11 xvfb-run -a -s "
                                        (sh-quote "-screen 0 1600x1200x24")
                                        " jolt gtk:selftest")}))}
  linux:build
  {:doc "Build the Linux jonquil binary in the image; it lands in target/linux/<arch>/ (--arch arm64|amd64)"
   :task (let [arch (linux-arch *command-line-args*)
               out  (str (fs/absolutize (str "target/linux/" arch)))]
           (fs/create-dirs out)
           (linux-docker {:arch arch :out out
                          :command "jolt app:build && cp jonquil /out/jonquil"}))}
  linux:run
  {:doc "Run a command in the copied tree in the Linux image: jolt linux:run [--arch A] [--] <command...>"
   :task (let [[opts cmd] (linux-run-split *command-line-args*)
               arch (linux-arch opts)]
           (if (empty? cmd)
             (do (println "usage: jolt linux:run [--arch arm64|amd64] [--] <command...>")
                 (System/exit 1))
             (linux-docker {:arch arch :command (str/join " " (map sh-quote cmd))})))}
  linux:vnc
  {:doc "A Linux desktop in Docker served through noVNC for a hand check: first free port from 6080, or --port P (refused if busy)"
   :task (let [args  (vec *command-line-args*)
               arch  (linux-arch args)
               rest* (linux-strip-arch args)
               asked (let [flag (drop-while (fn [a] (not (str/starts-with? a "--port"))) rest*)
                           a    (first flag)]
                       (when a (if (= a "--port") (second flag) (str/replace-first a "--port=" ""))))
               port  (cond
                       (nil? asked) (free-port 6080)
                       (re-matches (re-pattern "[0-9]+") asked)
                       (let [p (parse-long asked)]
                         (if (= p (free-port p))
                           p
                           (do (println (str "Port " p " is busy; pick another or omit --port"))
                               (System/exit 1))))
                       :else (do (println (str "--port needs a number, got: " asked)) (System/exit 1)))]
           (if port
             (linux-vnc {:arch arch :port port})
             (do (println "No free port in 6080-6100; pass one: jolt linux:vnc --port P")
                 (System/exit 1))))}
  linux:clean
  {:doc "Remove the jonquil-linux images (both arches) and delete target/linux"
   :task (do (doseq [arch ["arm64" "amd64"]]
               (shell "docker" "image" "rm" "-f" (str "jonquil-linux:" arch)))
             (fs/delete-tree "target/linux")
             (println "removed jonquil-linux images and target/linux"))}
  clean:tmp
  {:doc "Delete the temp files and dirs earlier test and self-test runs left under java.io.tmpdir (--dry-run lists them)"
   ;; Only names this repo's tests and harnesses make: a known prefix
   ;; followed by the digit its timestamp starts with. The app's own child
   ;; logs (jonquil-nrepl-<n>.log) aren't on the list. A symlinked
   ;; directory is never followed, so nothing outside tmpdir is touched.
   :task (let [dry? (some #{"--dry-run"} *command-line-args*)
               prefixes ["jonquil-settings-test-" "jonquil-jank-" "jonquil-source-test-" "jonquil-dialect-test-" "jonquil-nrepl-test-"
                         "jonquil-attach-test-" "jonquil-jvm-test-" "jonquil-selftest-"
                         "jonquil-selftest-window-settings-" "jonquil-selftest-nrepl-"
                         "jonquil-selftest-loose-" "jonquil-selftest-cljd-" "jonquil-selftest-clj-"
                         "jonquil-selftest-clj-outside-" "jonquil-selftest-jank-" "jonquil-selftest-cljs-node-" "jonquil-selftest-open-url-" "jonquil-cljs-"
                         "jonquil-selftest-dialect-" "jonquil-selftest-atomic-"
                         "jonquil-selftest-bad-settings-" "jonquil-selftest-badutf8-"
                         "jonquil-selftest-capslock-" "jonquil-selftest-close-fail-"
                         "jonquil-selftest-close-save-" "jonquil-selftest-dirty-"
                         "jonquil-selftest-exec-" "jonquil-selftest-impossible-parent-"
                         "jonquil-selftest-missing-dir-" "jonquil-selftest-readonly-"
                         "jonquil-selftest-source-" "jonquil-selftest-tabs-" "jonquil-selftest-appopen-" "jonquil-selftest-tree-" "jonquil-selftest-args-" "jonquil-file-tree-test-"
                         "jonquil-selftest-symlink-link-" "jonquil-selftest-symlink-real-"
                         "jonquil-demoshots-settings-" "jonquil-demoshots-tabs-" "jonquil-demoshots-tree-" "jonquil-demoshots-jank-" "jonquil-clj-server-" "jonquil-clj-config-"
                         "jonquil-smoke-xdg-" "jonquil-cljd-smoke-xdg-" "jonquil-login-path-test-" "jonquil-app-bundle-test-" "jonquil-app-linux-test-" "jonquil-save-path" "jonquil-jank-child-test-" "jonquil-mcp-test-" "jonquil-mcp-smoke-" "jonquil-mcp-listen-test-" "jonquil-selftest-mcp-" "jonquil-selftest-mcp-dir-"]
               prefix-of (fn [^java.io.File f]
                           (let [n (.getName f)]
                             (some (fn [p]
                                     (when (and (str/starts-with? n p)
                                                (< (count p) (count n))
                                                (Character/isDigit (.charAt n (count p))))
                                       p))
                                   prefixes)))
               del! (fn del! [^java.io.File f]
                      (when (and (.isDirectory f) (not (java.nio.file.Files/isSymbolicLink (.toPath f))))
                        (doseq [c (.listFiles f)] (del! c)))
                      (.delete f))
               tmp (java.io.File. (System/getProperty "java.io.tmpdir"))
               hits (keep (fn [f] (when-let [p (prefix-of f)] [p f])) (.listFiles tmp))]
           (doseq [[p fs] (sort-by key (group-by first hits))]
             (println (format "%6d  %s*" (count fs) p)))
           (if dry?
             (println (str (count hits) " entries under " tmp " (dry run, nothing deleted)"))
             (do (doseq [[_ f] hits] (del! f))
                 (println (str "deleted " (count hits) " entries under " tmp)))))}}}
