   :task (shell "jolt" "-M:bundle" "-m" "app-bundle" "bundle")}
  app:release
  {:doc "Build a self-contained target/Jonquil.app and target/Jonquil-<version>-macos-arm64.zip: GTK and its libraries bundled, ad-hoc signed unless JONQUIL_SIGN_IDENTITY names an identity (macOS, Apple Silicon)"
   :task (shell "jolt" "-M:bundle" "-m" "app-release" "release")}
  app:release-check
  {:doc "Launch target/Jonquil.app (or the app given) for 10 seconds with /opt/homebrew unreadable; fails when it exits early or loads a library from outside the bundle (macOS)"
   :task (apply shell "jolt" "-M:bundle" "-m" "app-release" "check" *command-line-args*)}
