;; Task runner for Jonquil -- a DrRacket-style Clojure IDE written in Jolt.
;;
;; Run these with EITHER `bb <task>` or `jolt <task>`; jolt reads this file
;; as well as deps.edn, so both runners see the same task list. `bb info`
;; (or `jolt info`) prints the grouped cheat-sheet; `bb tasks` lists
;; everything alphabetically.
;;
;; NOTE: task bodies are EDN-parsed. No #"regex", no @deref, no #(...) --
;; use (re-pattern "...") , (deref ...) and (fn [x] ...) instead.
{:tasks
 {:requires ([babashka.fs :as fs]
             [clojure.string :as str])

  :init
  (do
    ;; bb sets babashka.version, jolt sets jolt.version. Only `info` needs
    ;; this, to print the command the reader actually typed.
    (def runner (if (System/getProperty "babashka.version") "bb" "jolt"))

    (defn lsp-filenames
      "The --filenames scope for clojure-lsp's format and clean-ns commands:
       src, test, and every real dev/*.clj entry, joined with a comma (NOT
       `::` -- measured against clojure-lsp 2026.05.05-12.58.26, a `::`-joined
       multi-entry list throws a FileNotFoundException on the bare project
       root instead of doing anything with the entries).

       dev/smoke/fixtures/*.clj are deliberately invalid or minimal Clojure,
       fed to the built jonquil binary by dev/smoke/binary_smoke.clj to
       exercise unclosed-paren recovery, completion, find, etc. clojure-lsp's
       format and clean-ns commands parse every file under a discovered
       source-path with rewrite-clj, which throws a hard \"Unexpected EOF\"
       on fixtures/unclosed.clj and aborts the whole run -- measured with no
       scoping at all, and again with :source-paths-ignore-regex targeting
       the fixtures path (neither stops the crash, because \"dev\" is itself
       the discovered source-path and the ignore-regex only filters
       candidate source-path roots, not files underneath one already
       chosen). So this function is the one place that keeps fixtures out of
       clojure-lsp's reach, by listing dev's real entries explicitly instead
       of handing clojure-lsp the whole directory.

       Rebuilt on every call rather than cached in a def, so a new top-level
       dev/*.clj file is picked up the next time any lsp: task runs; only
       dev/smoke/fixtures and dev/smoke/PixelAt.java need to stay off it,
       and both are excluded by the .clj filter below, not by name."
      []
      (let [clj-or-dir (fn [p] (or (fs/directory? p) (str/ends-with? (str p) ".clj")))
            dev-top (->> (fs/list-dir "dev")
                         (remove (fn [p] (= "smoke" (str (fs/file-name p)))))
                         (filter clj-or-dir))
            smoke   (->> (fs/list-dir "dev/smoke")
                         (filter (fn [p] (str/ends-with? (str p) ".clj"))))
            ;; Upstream lifts stay byte-close to kimtg/DrClojure-Neo so a
            ;; future re-sync diffs cleanly; the formatter would double their
            ;; divergence (syntax.clj: 170 -> 324 differing lines, measured).
            lifted  #{"src/jonquil/syntax.clj" "test/jonquil/upstream/syntax_test.clj"}
            src+test (->> (concat (fs/glob "src" "**.clj") (fs/glob "test" "**.clj"))
                          (map str)
                          (remove lifted)
                          sort)]
        (->> (concat src+test dev-top smoke)
             (map str)
             (str/join ","))))

    (defn hook-preflight!
      "Run the checks the hook will run, and say which of them fail RIGHT
       NOW. Installing a pre-commit hook against a tree that already fails
       its own checks blocks every commit, and the failure arrives later,
       at the worst moment, looking like the hook itself is broken. So warn,
       then install anyway -- the operator asked for the hook, and
       --no-verify is one flag away."
      []
      (let [kondo  (:exit (shell {:continue true :out :string :err :string}
                                 "clj-kondo" "--lint" "src" "test" "dev"))
            fmt    (:exit (shell {:continue true :out :string :err :string}
                                 "clojure-lsp" "format" "--dry" "--filenames" (lsp-filenames)))
            broken (remove nil?
                           [(when (= 3 kondo) "clj-kondo reports errors (exit 3)")
                            (when-not (zero? fmt) "clojure-lsp format --dry reports diffs")])]
        (when (seq broken)
          (println "!! This tree does not pass the hook's own checks yet:")
          (doseq [b broken] (println (str "     - " b)))
          (println "   Installing anyway. Until these are clean the hook will")
          (println "   reject every commit; bypass one with: git commit --no-verify")
          (println))))

    ;; --- documentation site -------------------------------------------------
    ;; The generator lives in jlt-commons/docs-engine, not here, so these
    ;; tasks are local preview only and are the one place needing that
    ;; checkout.
    (def docs-engine-repo "https://github.com/jlt-commons/docs-engine")

    (defn docs-engine-dir
      "Where the engine is checked out: $JLT_DOCS_ENGINE, else the usual
       jlt-commons spot, else a sibling directory. nil when none exist. The
       jlt-commons checkout comes before ../docs-engine because a sibling
       there can be an unrelated older fork (measured: ~/dev/b12n-oss has
       one), which would otherwise shadow the real engine silently."
      []
      (let [home (System/getProperty "user.home")]
        (->> [(System/getenv "JLT_DOCS_ENGINE")
              (str home "/dev/jlt-commons/docs-engine")
              "../docs-engine"]
             (remove nil?)
             (filter (fn [d] (fs/exists? (fs/file d "bb.edn"))))
             first)))

    (defn free-port
      "First port from base up to base+20 that is free on every interface
       right now, or nil. The engine does the real bind a moment later, so this is a
       probe: a port taken in between fails loudly in the engine, not
       silently. An explicit port is never scanned (see site:serve)."
      [base]
      (let [binds? (fn [p addr]
                     (try (with-open [_ (java.net.ServerSocket. p 1 (java.net.InetAddress/getByName addr))] true)
                          (catch Exception _ false)))]
        ;; Both probes: a 127.0.0.1 bind succeeds on macOS even while another
        ;; process holds *:p (measured: Docker on *:3001), and then localhost
        ;; traffic silently reaches whichever listener the OS prefers.
        (some (fn [p] (when (and (binds? p "0.0.0.0") (binds? p "127.0.0.1")) p))
              (range base (+ base 21)))))

    (defn site-task
      "Runs one of the engine's tasks against this project."
      [task & args]
      (if-let [engine (docs-engine-dir)]
        (let [argv (into ["bb" task (str (fs/cwd))] (remove nil? args))
              res  (apply shell {:dir (str engine) :continue true} argv)]
          (when-not (zero? (:exit res)) (System/exit (:exit res))))
        (do
          (println "The docs engine is not checked out anywhere I looked:")
          (println "  $JLT_DOCS_ENGINE, ~/dev/jlt-commons/docs-engine, ../docs-engine")
          (println)
          (println "  git clone" docs-engine-repo "../docs-engine")
          (println)
          (System/exit 1)))))

  info
  {:doc "Grouped task cheat-sheet (start here; easier to scan than `tasks`)"
   :task
   (let [esc (str (char 27) "[")
         col (fn [c s] (str esc c "m" s esc "0m"))
         hdr (fn [s] (println (str "\n" (col "35" (str "── " s " ──")))))
         row (fn [t d] (println (str "  " (col "36" (format "%-32s" (str runner " " t))) d)))]
     (println (col "1;35" "\nJonquil — a DrRacket-style Clojure IDE written in Jolt"))
     (println (col "2" (str "  runner: " runner "   ·   both `bb <task>` and `jolt <task>` work")))
     (hdr "Verify")
     (row "check" "require every project namespace headlessly, exit 0")
     (row "test" "run the unit suite; pass namespace names to run a subset")
     (row "test:nrepl" "live nREPL tests: spawn Jolt children (need the jolt-lang/nrepl checkout)")
     (row "test:clj" "live JVM tests: start a real clojure -M:serve (need java 17+ and the clojure CLI)")
     (row "test:jank" "live jank tests: launch a real jank repl (JONQUIL_JANK or any jank on PATH; skips without one)")
     (row "verify" "lint (report) + test (must pass) — pre-commit gate")
     (hdr "Run and build")
     (row "app:run [file|dir]" "launch Jonquil, optionally on a file or a project folder")
     (row "app:build" "build the ./jonquil binary (unsigned on macOS)")
     (row "app:bundle" "rebuild ./jonquil, then make ./Jonquil.app from it (macOS)")
     (row "app:install" "app:bundle, then move to ~/Applications and register it (macOS)")
     (row "app:icon" "regenerate resources/Jonquil.icns from resources/icon/icon.swift (macOS)")
     (row "smoke:binary" "automated smoke of the BUILT ./jonquil binary via cgevent")
     (row "smoke:cljd" "automated smoke of the ClojureDart dialect against your running app")
     (hdr "Self-test and docs")
     (row "gtk:selftest" "open real GTK windows and run the front-end self-test rows")
     (row "docs:shots" "self-capture docs/images/*.png (+ one GIF), one process per scene")
     (hdr "Quality — lint and format")
     (row "lint" "clj-kondo over src, test and dev (report only)")
     (row "lint:strict" "lint, but exit non-zero if there are any findings")
     (row "lsp:format" "reformat Clojure files (clojure-lsp; mutating)")
     (row "lsp:format-check" "check formatting — dry run")
     (row "lsp:clean-ns" "clean + organize ns forms (clojure-lsp; mutating)")
     (row "lsp:clean-ns-check" "check ns forms — dry run")
     (row "lsp:check" "format + clean-ns, both dry run")
     (hdr "Git hooks")
     (row "hooks:install" "install FAST pre-commit hook (lint errors + format --dry)")
     (row "hooks:install:full" "install FULL pre-commit hook (+ unit tests, slower)")
     (row "hooks:uninstall" "remove the git pre-commit hook")
     (hdr "Docs (local preview; the engine lives in jlt-commons/docs-engine)")
     (row "site:build" "build the documentation site into _site/")
     (row "site:serve [port]" "build, then serve it (first free port from 3000)")
     (row "site:clean" "delete the _site/ build output")
     (row "clean:tmp [--dry-run]" "delete temp dirs earlier test runs left in java.io.tmpdir")
     (hdr "Upstream")
     (row "upstream:diff" "list upstream DrClojure commits since the pin, touching src/test")
     (println (str "\n" (col "2" (str "first run: " runner " check, then " runner " test, then " runner " app:run")))))}

  test  {:doc "Run tests; pass namespace names to run a subset"
         :task (apply shell "jolt" "-M:test" *command-line-args*)}
  test:nrepl {:doc "Live nREPL tests: spawn Jolt children (need the jolt-lang/nrepl checkout)"
              :task (shell "jolt" "-M:test" "--live")}
  test:clj {:doc "Live JVM tests: start a real clojure -M:serve (need java 17+ and the clojure CLI)"
            :task (shell "jolt" "-M:test" "--live-clj")}
  test:jank {:doc "Live jank tests: launch a real jank repl (JONQUIL_JANK or any jank on PATH; skips without one)"
             :task (shell "jolt" "-M:test" "--live-jank")}
  check {:doc "Headless compile-check of every project namespace"
         :task (shell "jolt" "-M:check")}
  gtk:selftest
  {:doc "Open seven real GTK windows in turn and run the front-end self-test rows (the third runs Jolt over nREPL, the fourth attaches to a fake ClojureDart app, the fifth attaches to a fake JVM nREPL server, the sixth is launched on a directory, the seventh runs a jank window against a fake jank process)"
   :task (let [r1 (shell {:continue true} "jolt" "-M:selftest")
               r2 (shell {:continue true} "jolt" "-M:selftest-window")
               r3 (shell {:continue true} "jolt" "-M:selftest-nrepl")
               r4 (shell {:continue true} "jolt" "-M:selftest-cljd")
               r5 (shell {:continue true} "jolt" "-M:selftest-clj")
               r6 (shell {:continue true} "jolt" "-M:selftest-tree")
               r7 (shell {:continue true :extra-env {"JONQUIL_JANK" (str (fs/absolutize "dev/fake-jank"))}}
                         "jolt" "-M:selftest-jank")
               ok1 (zero? (:exit r1))
               ok2 (zero? (:exit r2))
               ok3 (zero? (:exit r3))
               ok4 (zero? (:exit r4))
               ok5 (zero? (:exit r5))
               ok6 (zero? (:exit r6))
               ok7 (zero? (:exit r7))]
           (when-not ok1 (println "gtk:selftest: editor/console rows FAILED"))
           (when-not ok2 (println "gtk:selftest: window rows FAILED"))
           (when-not ok3 (println "gtk:selftest: nREPL rows FAILED"))
           (when-not ok4 (println "gtk:selftest: ClojureDart rows FAILED"))
           (when-not ok5 (println "gtk:selftest: JVM Clojure rows FAILED"))
           (when-not ok6 (println "gtk:selftest: directory-launch rows FAILED"))
           (when-not ok7 (println "gtk:selftest: jank rows FAILED"))
           (System/exit (if (and ok1 ok2 ok3 ok4 ok5 ok6 ok7) 0 1)))}
  docs:shots
  {:doc "Self-capture docs/images/*.png (+ one GIF): one fresh process per scene"
   ;; P2.T9 round 1: one shared process/window for all 7 scenes let every
   ;; scene inherit every earlier scene's console history, so a scene's
   ;; screenshot showed more than its own output. A fresh `jolt -M:shots
   ;; <scene-id>` process per scene means a fresh session and an empty
   ;; console every time. This scene-id list is kept in sync by hand with
   ;; dev/demo_shots.clj's own `scenes` list, the same way dev/check.clj
   ;; and dev/test_runner.clj's namespace lists are.
   :task (let [scene-ids ["window" "repl" "stdin" "stop" "unbalanced" "unicode" "run-while-running"
                          "find" "run-selection" "close-prompt"
                          "theme-light" "theme-dark" "theme-solarized" "theme-navy"
                          "completion" "quick-doc" "rename" "inspector"
                          "clj-attach" "clj-quick-doc" "clj-full-doc" "clj-inspector" "clj-source" "tabs" "file-tree" "jank"]
               results (mapv (fn [id]
                               (let [r (shell {:continue true} "jolt" "-M:shots" id)]
                                 {:id id :ok (zero? (:exit r))}))
                             scene-ids)
               failed (filterv (fn [r] (not (:ok r))) results)]
           (doseq [r results]
             (println (str "docs:shots: " (:id r) " " (if (:ok r) "PASS" "FAIL"))))
           (when (seq failed)
             (println (str "docs:shots: " (count failed) " of " (count results) " scenes FAILED")))
           (System/exit (if (seq failed) 1 0)))}
  app:run
  {:doc "Launch Jonquil, optionally opening a file or a project folder (the file tree roots there)"
   :task (apply shell "jolt" "-M" "-m" "jonquil.main" *command-line-args*)}
  app:build
  {:doc "Build the ./jonquil binary (unsigned on macOS)"
   :task (shell "jolt" "build" "-m" "jonquil.main" "-o" "jonquil")}
  app:bundle
  {:doc "Rebuild ./jonquil, then make ./Jonquil.app from it (macOS)"
   :depends [app:build]
   :task (shell "jolt" "-M:bundle" "-m" "app-bundle" "bundle")}
  app:install
  {:doc "app:bundle, then move Jonquil.app to ~/Applications and register it with LaunchServices (macOS)"
   :depends [app:bundle]
   :task (shell "jolt" "-M:bundle" "-m" "app-bundle" "install")}
  app:icon
  {:doc "Regenerate resources/Jonquil.icns: swift draws a 1024px PNG, sips scales it, iconutil packs it (macOS)"
   :task (let [tmp (str (fs/create-temp-dir {:prefix "jonquil-icon-"}))
               set-dir (str tmp "/Jonquil.iconset")
               big (str tmp "/icon-1024.png")]
           (try
             (fs/create-dirs set-dir)
             (shell "swift" "resources/icon/icon.swift" big)
             (doseq [n [16 32 128 256 512]]
               (shell "sips" "-z" (str n) (str n) big "--out" (str set-dir "/icon_" n "x" n ".png"))
               (shell "sips" "-z" (str (* 2 n)) (str (* 2 n)) big "--out" (str set-dir "/icon_" n "x" n "@2x.png")))
             (shell "iconutil" "-c" "icns" set-dir "-o" "resources/Jonquil.icns")
             (finally (fs/delete-tree tmp))))}
  smoke:binary
  {:doc "P2.T10: automated smoke of the BUILT ./jonquil binary via cgevent --pid. Builds into target/smoke/jonquil first unless --no-build is given."
   :task (apply shell "bb" "dev/smoke/binary_smoke.clj" *command-line-args*)}
  smoke:cljd
  {:doc "P4.T3 automated: smokes the ClojureDart attach dialect against your running a-sibling-cljd-app app (bb dev:macos) via cgevent --pid. Builds ./jonquil first unless --no-build is given."
   :task (apply shell "bb" "dev/smoke/cljd_smoke.clj" *command-line-args*)}
  upstream:diff
  {:doc "List upstream DrClojure commits since the pin that touch src or test"
   :task (let [dir (or (System/getenv "DRCLOJURE_DIR")
                       (str (System/getProperty "user.home")
                            "/dev/b12n-oss/kimtg--DrClojure-Neo"))
               pin (clojure.string/trim (slurp "UPSTREAM_PIN"))]
           (shell {:dir dir} "git" "fetch" "--quiet" "upstream")
           (shell {:dir dir} "git" "log" "--oneline"
                  (str pin "..upstream/main") "--" "src" "test"))}

  verify
  {:doc "Pre-commit gate: lint (report) + test (must pass)"
   :task (do (shell {:continue true} "clj-kondo" "--lint" "src" "test" "dev")
             (shell "jolt" "-M:test")
             (shell "jolt" "-M:test" "--live"))}

  ;; --- quality ----------------------------------------------------------
  lint
  {:doc "clj-kondo over src, test and dev (report only)"
   :task (let [{:keys [exit]} (shell {:continue true} "clj-kondo" "--lint" "src" "test" "dev")]
           (println (if (zero? exit)
                      "OK clj-kondo: no errors or warnings"
                      "-- clj-kondo: see findings above")))}

  lint:strict
  {:doc "lint, but exit non-zero if clj-kondo reports any findings (2=warnings, 3=errors)"
   :task (shell "clj-kondo" "--lint" "src" "test" "dev")}

  lsp:format
  {:doc "Reformat Clojure files (clojure-lsp; mutating). Skips dev/smoke/fixtures -- see lsp-filenames"
   :task (shell "clojure-lsp" "format" "--filenames" (lsp-filenames))}

  lsp:format-check
  {:doc "Check formatting — dry run"
   :task (shell "clojure-lsp" "format" "--dry" "--filenames" (lsp-filenames))}

  lsp:clean-ns
  {:doc "Clean + organize ns forms (clojure-lsp; mutating). Skips dev/smoke/fixtures -- see lsp-filenames"
   :task (shell "clojure-lsp" "clean-ns" "--filenames" (lsp-filenames))}

  lsp:clean-ns-check
  {:doc "Check ns forms — dry run"
   :task (shell "clojure-lsp" "clean-ns" "--dry" "--filenames" (lsp-filenames))}

  lsp:check
  {:doc "format + clean-ns, both dry run"
   :task (do (shell "clojure-lsp" "format" "--dry" "--filenames" (lsp-filenames))
             (shell "clojure-lsp" "clean-ns" "--dry" "--filenames" (lsp-filenames)))}

  ;; --- git hooks ----------------------------------------------------------
  hooks:install
  {:doc "Install FAST git pre-commit hook (clj-kondo errors + clojure-lsp format --dry, ~2s)"
   :task (let [hook (str/trim (:out (shell {:out :string} "git" "rev-parse" "--git-path" "hooks/pre-commit")))]
           (hook-preflight!)
           (spit hook (str "#!/bin/bash\n"
                           "# Jonquil pre-commit (FAST -- clj-kondo errors-only + clojure-lsp format --dry).\n"
                           "# Full (+ test suite): bb hooks:install:full\n"
                           "# The format step runs `bb lsp:format-check`, so its file list (lsp-filenames\n"
                           "# in bb.edn) is computed fresh on every commit.\n"
                           "echo 'pre-commit 1/2: clj-kondo (errors only)'\n"
                           "clj-kondo --lint src test dev\n"
                           "LINT_EXIT=$?\n"
                           "if [ \"$LINT_EXIT\" = \"3\" ]; then echo 'pre-commit: lint errors found'; exit 1; fi\n"
                           "echo 'pre-commit 2/2: clojure-lsp format --dry'\n"
                           "bb lsp:format-check >/dev/null || { echo 'run bb lsp:format'; exit 1; }\n"
                           "exit 0\n"))
           (shell "chmod" "+x" hook)
           (println "OK fast pre-commit hook installed")
           (println ">> skip once with: git commit --no-verify"))}

  hooks:install:full
  {:doc "Install FULL git pre-commit hook (clj-kondo errors + format --dry + unit tests, slower)"
   :task (let [hook (str/trim (:out (shell {:out :string} "git" "rev-parse" "--git-path" "hooks/pre-commit")))]
           (hook-preflight!)
           (spit hook (str "#!/bin/bash\n"
                           "# Jonquil pre-commit (FULL). Fast: bb hooks:install\n"
                           "echo 'pre-commit 1/3: clj-kondo (errors only)'\n"
                           "clj-kondo --lint src test dev\n"
                           "LINT_EXIT=$?\n"
                           "if [ \"$LINT_EXIT\" = \"3\" ]; then echo 'pre-commit: lint errors found'; exit 1; fi\n"
                           "echo 'pre-commit 2/3: clojure-lsp format --dry'\n"
                           "bb lsp:format-check >/dev/null || { echo 'run bb lsp:format'; exit 1; }\n"
                           "echo 'pre-commit 3/3: unit tests'\n"
                           "jolt -M:test\n"
                           "exit $?\n"))
           (shell "chmod" "+x" hook)
           (println "OK full pre-commit hook installed")
           (println ">> skip once with: git commit --no-verify"))}

  hooks:uninstall
  {:doc "Remove the git pre-commit hook"
   :task (let [hook (str/trim (:out (shell {:out :string} "git" "rev-parse" "--git-path" "hooks/pre-commit")))]
           (if (fs/exists? hook)
             (do (fs/delete hook) (println "OK pre-commit hook removed"))
             (println ">> no pre-commit hook found")))}

  ;; --- docs -----------------------------------------------------------------
  site:build
  {:doc "Build the documentation site into _site/ (needs a docs-engine checkout)"
   :task (site-task "build")}

  site:serve
  {:doc "Build the docs site and serve it locally; first free port from 3000, or site:serve PORT (refused if busy)"
   :task (let [asked (first *command-line-args*)
               port  (or asked (free-port 3000))]
           (if port
             (site-task "serve" (str port))
             (do (println "No free port in 3000-3020 on 127.0.0.1; pass one: bb site:serve PORT")
                 (System/exit 1))))}

  site:clean
  {:doc "Delete the _site/ build output"
   :task (site-task "clean")}

  clean:tmp
  {:doc "Delete the temp files and dirs earlier test and self-test runs left under java.io.tmpdir (--dry-run lists them)"
   ;; Only names this repo's tests and harnesses make: a known prefix
   ;; followed by the digit its timestamp starts with. The app's own child
   ;; logs (jonquil-nrepl-<n>.log) aren't on the list. A symlinked
   ;; directory is never followed, so nothing outside tmpdir is touched.
   :task (let [dry? (some #{"--dry-run"} *command-line-args*)
               prefixes ["jonquil-settings-test-" "jonquil-jank-" "jonquil-source-test-" "jonquil-dialect-test-" "jonquil-nrepl-test-"
                         "jonquil-attach-test-" "jonquil-jvm-test-" "jonquil-selftest-"
                         "jonquil-selftest-window-settings-" "jonquil-selftest-nrepl-"
                         "jonquil-selftest-loose-" "jonquil-selftest-cljd-" "jonquil-selftest-clj-"
                         "jonquil-selftest-clj-outside-" "jonquil-selftest-jank-"
                         "jonquil-selftest-dialect-" "jonquil-selftest-atomic-"
                         "jonquil-selftest-bad-settings-" "jonquil-selftest-badutf8-"
                         "jonquil-selftest-capslock-" "jonquil-selftest-close-fail-"
                         "jonquil-selftest-close-save-" "jonquil-selftest-dirty-"
                         "jonquil-selftest-exec-" "jonquil-selftest-impossible-parent-"
                         "jonquil-selftest-missing-dir-" "jonquil-selftest-readonly-"
                         "jonquil-selftest-source-" "jonquil-selftest-tabs-" "jonquil-selftest-appopen-" "jonquil-selftest-tree-" "jonquil-file-tree-test-"
                         "jonquil-selftest-symlink-link-" "jonquil-selftest-symlink-real-"
                         "jonquil-demoshots-settings-" "jonquil-demoshots-tabs-" "jonquil-demoshots-tree-" "jonquil-demoshots-jank-" "jonquil-clj-server-" "jonquil-clj-config-"
                         "jonquil-smoke-xdg-" "jonquil-cljd-smoke-xdg-" "jonquil-login-path-test-" "jonquil-app-bundle-test-"]
               prefix-of (fn [^java.io.File f]
                           (let [n (.getName f)]
                             (some (fn [p]
                                     (when (and (str/starts-with? n p)
                                                (< (count p) (count n))
                                                (Character/isDigit (.charAt n (count p))))
                                       p))
                                   prefixes)))
               del! (fn del! [^java.io.File f]
                      (when (and (.isDirectory f) (not (java.nio.file.Files/isSymbolicLink (.toPath f))))
                        (doseq [c (.listFiles f)] (del! c)))
                      (try (java.nio.file.Files/deleteIfExists (.toPath f)) (catch Exception _ nil)))
               tmp (java.io.File. (System/getProperty "java.io.tmpdir"))
               hits (keep (fn [f] (when-let [p (prefix-of f)] [p f])) (.listFiles tmp))]
           (doseq [[p fs] (sort-by key (group-by first hits))]
             (println (format "%6d  %s*" (count fs) p)))
           (if dry?
             (println (str (count hits) " entries under " tmp " (dry run, nothing deleted)"))
             (do (doseq [[_ f] hits] (del! f))
                 (println (str "deleted " (count hits) " entries under " tmp)))))}}}
