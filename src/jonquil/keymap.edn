;; The shipped keymap. Read by jonquil.keymap/shipped when Jonquil is
;; compiled. Each scope is an ORDERED vector: the first binding that matches
;; wins. :cmd is Control or Meta.
;;
;; :window is the whole of jonquil.gtk.window/on-window-key, after one fixed
;; stage (jonquil.command-registry/window-answer: while the rename popover's
;; or the command palette's entry has focus, every key but Escape is the
;; entry's). Shift-qualified bindings sit ahead of their plain forms, so
;; the plain one never sees them.
{:window
 [;; F5 runs the buffer, whatever the modifiers
  {:key "F5" :command :run/run}
  ;; the Escape chain, in order, with no modifier checks. A command answers
  ;; an outcome: the popover close answers :next when nothing was open, so
  ;; the chain goes on; bare Escape with nothing to close or Stop is GTK's.
  {:key "Escape" :when [:find-bar-focused] :command :find/bar-key}
  {:key "Escape" :command :popover/close-all}
  {:key "Escape" :when [:inspector-focused] :command :inspector/close}
  {:key "Escape" :when [:source-focused] :command :source/close}
  {:key "Escape" :when [:tree-focused :tree-menu-open] :command :tree/close-menu}
  {:key "Escape" :when [:tree-focused] :command :tree/leave}
  {:key "Escape" :when [:evaluating] :command :run/stop}
  {:key "Escape" :outcome :to-gtk}
  ;; find navigation: F3 and Cmd+G are find-bar/handle-nav-key!'s own four
  ;; branches, guarded by its two checks (the bar is open, no IME composition).
  {:key "F3" :mods #{:shift} :when [:find-bar-navigable] :command :find/previous}
  {:key "F3" :when [:find-bar-navigable] :command :find/next}
  {:key "g" :mods #{:cmd :shift} :when [:find-bar-navigable] :command :find/previous}
  {:key "g" :mods #{:cmd} :when [:find-bar-navigable] :command :find/next}
  ;; plain F6; Shift+F6 is rename, which the editor gets
  {:key "F6" :not #{:shift} :command :focus/toggle}
  ;; the locations list: F8 steps forward, Shift+F8 back
  {:key "F8" :exact #{} :command :locations/next}
  {:key "F8" :exact #{:shift} :command :locations/previous}
  ;; and Cmd/Ctrl+. and Cmd/Ctrl+Shift+., since a Mac keyboard sends F8 to
  ;; Music unless fn is held; Shift+. arrives as greater
  {:key "period" :mods #{:cmd} :not #{:alt} :command :locations/next}
  {:key "greater" :mods #{:cmd} :not #{:alt} :command :locations/previous}
  {:key "o" :mods #{:cmd :shift} :when [:source-focused] :command :source/open-here}
  ;; Parinfer: Cmd/Ctrl+Alt+P cycles the mode (upstream's Ctrl+Alt+P). On
  ;; macOS Option remaps P's keyval; :physical? matches the keycode, as the
  ;; editor's format-selection chord does.
  {:key "p" :mods #{:cmd :alt} :physical? true :command :parinfer/next-mode}
  ;; the plain command chords
  {:key "r" :mods #{:cmd} :command :run/run}
  {:key "o" :mods #{:cmd} :command :file/open}
  {:key "s" :mods #{:cmd :shift} :command :file/save-as}
  {:key "s" :mods #{:cmd} :command :file/save}
  {:key "w" :mods #{:cmd} :command :tab/close}
  {:key "e" :mods #{:cmd :shift} :command :tree/toggle}
  {:key "e" :mods #{:cmd} :not #{:shift} :command :run/selection}
  ;; :not #{:alt}: Cmd+Alt+L and Cmd+Alt+F are the editor's format chords,
  ;; and Cmd+Shift+F (format all) is the editor's too
  {:key "l" :mods #{:cmd :shift} :not #{:alt} :command :console/clear-last-output}
  {:key "l" :mods #{:cmd} :not #{:alt} :command :console/clear}
  {:key "f" :mods #{:cmd} :not #{:alt :shift} :command :find/open}
  {:key "h" :mods #{:cmd} :command :find/open-replace}
  {:keys #{"equal" "plus"} :mods #{:cmd} :command :view/zoom-in}
  {:key "minus" :mods #{:cmd} :command :view/zoom-out}
  {:key "0" :mods #{:cmd} :command :view/zoom-reset}
  ;; the panels, ahead of Cmd/Ctrl+1..6's tabs, whose bindings don't rule
  ;; out Alt; on macOS Option remaps the digit's keyval, so :physical?
  {:key "1" :mods #{:cmd :alt} :physical? true :command :panel/inspector}
  {:key "2" :mods #{:cmd :alt} :physical? true :command :panel/source}
  {:key "3" :mods #{:cmd :alt} :physical? true :command :panel/locations}
  {:key "4" :mods #{:cmd :alt} :physical? true :command :panel/frames}
  {:key "5" :mods #{:cmd :alt} :physical? true :command :panel/trace}
  {:key "6" :mods #{:cmd :alt} :physical? true :command :panel/plugins}
  {:key "1" :mods #{:cmd} :command :tab/select :args {:n 1}}
  {:key "2" :mods #{:cmd} :command :tab/select :args {:n 2}}
  {:key "3" :mods #{:cmd} :command :tab/select :args {:n 3}}
  {:key "4" :mods #{:cmd} :command :tab/select :args {:n 4}}
  {:key "5" :mods #{:cmd} :command :tab/select :args {:n 5}}
  {:key "6" :mods #{:cmd} :command :tab/select :args {:n 6}}
  {:key "7" :mods #{:cmd} :command :tab/select :args {:n 7}}
  {:key "8" :mods #{:cmd} :command :tab/select :args {:n 8}}
  ;; 9 is the last tab, whatever the count
  {:key "9" :mods #{:cmd} :command :tab/select :args {:n 9}}
  {:key "t" :mods #{:cmd} :command :tab/new}
  {:key "m" :mods #{:cmd :shift} :command :view/cycle-theme}
  {:key "i" :mods #{:cmd :shift} :command :inspect/form}
  {:key "i" :mods #{:cmd} :command :inspect/last}
  ;; the command palette
  {:key "p" :mods #{:cmd :shift} :command :palette/open}
  {:key "braceright" :mods #{:cmd} :command :tab/next}
  {:key "braceleft" :mods #{:cmd} :command :tab/previous}
  ;; Cmd/Ctrl+[ steps the focused source panel back; anywhere
  ;; else it goes back from a jump into a tab, and with none to go back
  ;; from answers :next, so the key passes on
  {:key "bracketleft" :mods #{:cmd} :when [:source-focused] :command :source/back}
  {:key "bracketleft" :mods #{:cmd} :command :source/jump-back}]
 ;; jonquil.gtk.editor/handle-key!'s chords, between the
 ;; completion popup and the typing stages (smart enter, auto-pairs,
 ;; Backspace, Tab), as jonquil.command-registry/editor-answer orders them.
 ;; An edit command's 0 makes the key GTK's.
 :editor
 [;; Run Form: Return or KP-Enter with Control or Meta, whatever else is
  ;; held. Always used up, so GtkTextView never inserts a newline for it,
  ;; and the completion popup ignores any key held with Control or Meta,
  ;; so an open popup doesn't take it.
  {:keys #{"Return" "KP_Enter"} :mods #{:cmd} :command :run/form}
  ;; Ctrl+Space: Control, never Meta. Always used up, popup
  ;; or not, so GTK never inserts the space.
  {:key "space" :mods #{:ctrl} :not #{:meta} :command :completion/open}
  {:keys #{"slash" "semicolon"} :mods #{:cmd} :command :edit/toggle-comment}
  {:key "f" :mods #{:cmd :shift} :command :edit/format-all}
  ;; on macOS Option turns F and L into other keyvals; :physical? matches
  ;; them by their keycode (jonquil.gtk.editor/physical-key)
  {:keys #{"f" "l"} :mods #{:cmd :alt} :physical? true :command :edit/format-selection}
  ;; a read-only buffer has no redo, and the key goes on to the typing stages
  {:key "y" :mods #{:cmd} :when [:writable] :command :edit/redo}
  ;; quick doc and jump: Control and never Meta for the Control chords,
  ;; exactly Shift for Shift+F1, nothing for F12
  {:key "q" :mods #{:ctrl} :not #{:meta} :command :help/quick-doc}
  {:key "F1" :exact #{:shift} :command :help/quick-doc}
  {:key "F12" :exact #{} :command :help/jump}
  {:key "b" :mods #{:ctrl} :not #{:meta} :command :help/jump}
  ;; rename: Shift+F6 reaches here because the window's F6 binding is
  ;; :not #{:shift}; exactly Shift, so Cmd+Shift+F6 doesn't rename
  {:key "F6" :exact #{:shift} :command :edit/rename}
  {:key "F2" :exact #{} :command :edit/rename}]}
