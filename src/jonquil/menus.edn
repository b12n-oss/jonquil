;; The menus. Read by jonquil.menus/shipped when Jonquil is compiled.
;;
;; A vector of menus, each {:label s :sections [[item ...] ...]}; a line
;; separates the sections. An item is {:command id :label s}, or a submenu,
;; {:label s :sections [...]}. A label ending in "…" opens something that
;; asks for more. Keys aren't written here: each item shows the first key
;; the live key map gives its command.
[{:label "File"
  :sections [[{:command :tab/new :label "New Tab"}
              {:command :file/open :label "Open…"}]
             [{:command :file/save :label "Save"}
              {:command :file/save-as :label "Save As…"}]
             [{:command :tab/close :label "Close Tab"}]]}
