{:paths ["src"]
 :deps {org.clojure/data.json {:mvn/version "2.5.1"}
        ;; data.json needs java.time.format.DateTimeFormatter, which Jolt
        ;; supplies through this library (RFC 0014).
        io.github.jolt-lang/time {:git/url "https://github.com/jolt-lang/time.git"
                                  :git/tag "v0.0.12" :git/sha "cb2e1c7"}}
 :jolt/native [{:name "glib-2.0" :optional true
                :darwin ["/opt/homebrew/lib/libglib-2.0.0.dylib" "/usr/local/lib/libglib-2.0.0.dylib" "libglib-2.0.0.dylib"]
                :linux ["libglib-2.0.so.0" "libglib-2.0.so"]}
               {:name "gobject-2.0" :optional true
                :darwin ["/opt/homebrew/lib/libgobject-2.0.0.dylib" "/usr/local/lib/libgobject-2.0.0.dylib" "libgobject-2.0.0.dylib"]
                :linux ["libgobject-2.0.so.0" "libgobject-2.0.so"]}
               {:name "gio-2.0" :optional true
                :darwin ["/opt/homebrew/lib/libgio-2.0.0.dylib" "/usr/local/lib/libgio-2.0.0.dylib" "libgio-2.0.0.dylib"]
                :linux ["libgio-2.0.so.0" "libgio-2.0.so"]}
               {:name "pango-1.0" :optional true
                :darwin ["/opt/homebrew/lib/libpango-1.0.0.dylib" "/usr/local/lib/libpango-1.0.0.dylib" "libpango-1.0.0.dylib"]
                :linux ["libpango-1.0.so.0" "libpango-1.0.so"]}
               {:name "gtk-4" :optional true
                :darwin ["/opt/homebrew/lib/libgtk-4.1.dylib" "/usr/local/lib/libgtk-4.1.dylib" "libgtk-4.1.dylib"]
                :linux ["libgtk-4.so.1" "libgtk-4.so"]}]
 :aliases
 {;; Project tests. Pass namespace names to run a subset:
  ;;   jolt -M:test jonquil.edit-test
  :test {:extra-paths ["test" "dev"]
         :main-opts ["-m" "test-runner"]}
  ;; Builds and installs Jonquil.app: jolt -M:bundle -m app-bundle <bundle|install>
  :bundle {:extra-paths ["dev"]}
  ;; Headless compile-check: requires every project namespace and exits.
  :check {:extra-paths ["dev"]
          :main-opts ["-m" "check"]}
  ;; Code metrics report (jolt metrics): jolt-metrics' CLI. Report only.
  :metrics {:extra-deps {io.github.jlt-commons/jolt-metrics
                         {:git/url "https://github.com/jlt-commons/jolt-metrics"
                          :git/tag "v0.2.2" :git/sha "8568d4c"}}
            :main-opts ["-m" "metrics.cli"]}
  ;; GTK self-test: opens a real window and runs the front-end rows.
  :selftest {:extra-paths ["dev"]
             :main-opts ["-m" "gtk-selftest"]}
  ;; The same self-test, but against the real jonquil.main/start!
  ;; window instead of a bare editor+console -- needs its own alias because
  ;; :main-opts picks the FIRST -m it sees, so appending "-m
  ;; gtk-selftest-window" after :selftest's own "-m gtk-selftest" on the
  ;; command line wouldn't select a different namespace, it would just hand
  ;; those two tokens to gtk-selftest/-main as args.
  :selftest-window {:extra-paths ["dev"]
                    :main-opts ["-m" "gtk-selftest-window"]}
  ;; The nREPL window rows -- a real window whose project opts into
  ;; {:runtime :nrepl}, so a real Jolt child runs behind it.
  :selftest-nrepl {:extra-paths ["dev"]
                   :main-opts ["-m" "gtk-selftest-nrepl"]}
  ;; The ClojureDart window rows -- a real window on a
  ;; throwaway app directory whose NREPL.lock names a fake fork server in
  ;; the same process (dev/fake_cljd_nrepl.clj). No real app is involved.
  :selftest-cljd {:extra-paths ["dev"]
                  :main-opts ["-m" "gtk-selftest-cljd"]}
  ;; The JVM Clojure window rows -- a real window on a
  ;; throwaway JVM project directory whose .nrepl-port names a fake nREPL
  ;; server in the same process (dev/fake_jvm_nrepl.clj). No real JVM
  ;; server is involved.
  :selftest-clj {:extra-paths ["dev"]
                 :main-opts ["-m" "gtk-selftest-clj"]}
  ;; The fake jank nREPL server as a stand-in `jank`
  ;; executable (dev/fake-jank runs -m fake-jank-nrepl).
  :fake-jank {:extra-paths ["dev"]}
  ;; A fake prepl as a stand-in `clojure` (dev/fake-cljs-clojure).
  :fake-cljs {:extra-paths ["dev"]}
  ;; A jank window against the fake jank process. Run it
  ;; with JONQUIL_JANK pointing at dev/fake-jank (jolt gtk:selftest sets it).
  :selftest-jank {:extra-paths ["dev"]
                  :main-opts ["-m" "gtk-selftest-jank"]}
  ;; The ClojureScript-on-node window rows: dev/fake-cljs-clojure as JONQUIL_CLOJURE.
  :selftest-cljs-node {:extra-paths ["dev"]
                       :main-opts ["-m" "gtk-selftest-cljs-node"]}
  ;; A window launched on a directory.
  :selftest-tree {:extra-paths ["dev"]
                  :main-opts ["-m" "gtk-selftest-tree"]}
  ;; The ClojureScript window rows -- a real window on throwaway shadow-cljs
  ;; projects whose .shadow-cljs/nrepl.port names fake shadow servers in the
  ;; same process (dev/fake_shadow_nrepl.clj). No real shadow-cljs is involved.
  :selftest-cljs {:extra-paths ["dev"]
                  :main-opts ["-m" "gtk-selftest-cljs"]}
  ;; A launch with file and folder arguments (jonquil.main/gtk-argv).
  :selftest-args {:extra-paths ["dev"]
                  :main-opts ["-m" "gtk-selftest-args"]}
  ;; jolt bench:edit [sizes...]: editing-stall benchmark on large files (opens
  ;; a real window per size).
  :bench {:extra-paths ["dev"]
          :main-opts ["-m" "bench-edit"]}
  ;; Opens the real window and self-captures docs/images/*.png (+
  ;; one GIF) for the guide, driving jonquil.main/start! the same way
  ;; :selftest-window does.
  :shots {:extra-paths ["dev"]
          :main-opts ["-m" "demo-shots"]}}}
